# Database
MONGODB_URI=mongodb://localhost:27017
DATABASE_NAME=sm_visitor

# Authentication
JWT_SECRET=your-super-secret-key-change-this-in-production
JWT_EXPIRY_DAYS=7
OTP_EXPIRY_MINUTES=5

# Storage
# Options: "local" (GridFS + local buffer) or "cloudinary"
STORAGE_TYPE=local
LOCAL_STORAGE_PATH=./uploads

# S3 (if using cloud storage instead of Cloudinary)
S3_BUCKET=
S3_REGION=us-east-1
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Cloudinary (if using Cloudinary for image storage)
# Get these values from your Cloudinary dashboard: https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=your_cloud_name_here
CLOUDINARY_API_KEY=your_api_key_here
CLOUDINARY_API_SECRET=your_api_secret_here
CLOUDINARY_FOLDER=sm-visitor/photos

# Cloud names that were retired (e.g. an account replaced after it hit its plan
# quota). Comma separated. Photos stored against these are reported to the apps
# as needing a fresh capture instead of rendering as broken images. Any cloud
# name that simply differs from CLOUDINARY_CLOUD_NAME is treated the same way,
# so this is only needed for clouds that are still reachable but unwanted.
CLOUDINARY_RETIRED_CLOUD_NAMES=

# Photos are downscaled and re-encoded on upload. Visitor snapshots are only
# ever shown small, so storing camera originals burns storage and delivery
# credits for pixels nobody sees.
CLOUDINARY_UPLOAD_MAX_DIMENSION=1280
CLOUDINARY_UPLOAD_QUALITY=auto:good

# CORS
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# App URLs
ORBIT_URL=http://localhost:3000
HORIZON_URL=http://localhost:3001
PANTRY_URL=http://localhost:8000
